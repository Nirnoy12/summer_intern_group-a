# ==============================================================
# LMS Gamified Platform — Backend Environment Variables
# ==============================================================
# SETUP INSTRUCTIONS:
#   Windows (PowerShell): Copy-Item .env.example .env
#   Mac / Linux:          cp .env.example .env
# Then fill in every value below. Lines starting with # are comments.
# ==============================================================

# ── Database ────────────────────────────────────────────────────
# CockroachDB Serverless connection string.
# Format:  cockroachdb://<user>:<password>@<host>:26257/<database>?sslmode=verify-full&sslrootcert=system
# CRITICAL: Use cockroachdb:// NOT postgresql://
# CRITICAL (Windows ONLY): Append &sslrootcert=system at the end.
# Get credentials from your CockroachDB Cloud dashboard →  Connect → Connection string
DATABASE_URL=cockroachdb://<username>:<password>@<cluster-host>:26257/defaultdb?sslmode=verify-full&sslrootcert=system

# ── JWT Authentication ──────────────────────────────────────────
# A random 64-character hex string. KEEP THIS SECRET. Never commit to git.
# Generate one instantly:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_64_char_random_hex_string_never_commit_this

# ── YouTube Data API v3 ─────────────────────────────────────────
# 1. Go to: https://console.cloud.google.com/apis/credentials
# 2. Create a new API key
# 3. Restrict it to "YouTube Data API v3" for security
YOUTUBE_API_KEY=replace_with_your_youtube_api_key

# ── LLM Provider Selection ──────────────────────────────────────
# Choose which LLM backend to use for quiz generation.
#
#   LLM_PROVIDER=ollama   → Local model via Ollama (default, no internet needed)
#   LLM_PROVIDER=groq     → Free cloud API via Groq (no GPU required, fastest)
#
LLM_PROVIDER=ollama

# ── Ollama Config (only used when LLM_PROVIDER=ollama) ──────────
# URL where Ollama is running. Default is local.
OLLAMA_URL=http://localhost:11434/api/generate

# ─── Model Selection Guide for RTX 3050 4 GB VRAM ───────────────
# BEST QUALITY  (fits in 4 GB VRAM, ~2.0 GB):
#   OLLAMA_MODEL=qwen2.5:3b        ← RECOMMENDED  pull: ollama pull qwen2.5:3b
#
# FASTEST / LIGHTEST (~1.5 GB VRAM, great for testing):
#   OLLAMA_MODEL=phi3:mini          pull: ollama pull phi3:mini
#
# BALANCED (if you want to try):
#   OLLAMA_MODEL=gemma2:2b          pull: ollama pull gemma2:2b
#
# DO NOT USE on 4 GB VRAM (will cause OOM / extreme slowness):
#   llama3.1:8b, mistral:7b, gemma2:9b  ← require 6–8+ GB VRAM
OLLAMA_MODEL=qwen2.5:3b

# ── Groq Config (only used when LLM_PROVIDER=groq) ──────────────
# FREE cloud LLM API — no GPU required, no credit card needed.
# Sign up and get your free API key at: https://console.groq.com
#
# Free tier: ~30 requests/min, ~6 000 requests/day
# (More than enough for quiz generation in this app)
#
GROQ_API_KEY=replace_with_your_groq_api_key

# ─── Groq Model Selection Guide ─────────────────────────────────
# FASTEST (recommended for development, near-instant responses):
#   GROQ_MODEL=llama-3.1-8b-instant   ← DEFAULT, great JSON quality
#
# BEST QUALITY (higher latency but best reasoning):
#   GROQ_MODEL=llama-3.3-70b-versatile
#
# OTHER GOOD OPTIONS:
#   GROQ_MODEL=llama3-8b-8192         → Compact, very fast
#   GROQ_MODEL=gemma2-9b-it           → Google Gemma 2, accurate
#
GROQ_MODEL=llama-3.1-8b-instant

# ── Smart Quiz Scheduling Thresholds ────────────────────────────────────────
# These control when and how deep a quiz appears after a chapter of videos.
# All values are in seconds. You can tune these without touching any code.
#
# Minimum cumulative video seconds before a chapter quiz is triggered.
# Chapters shorter than this are merged into the next chapter (no tiny quizzes).
# Default: 600 (10 minutes)
QUIZ_MIN_CHAPTER_SECONDS=600
#
# Chapters < QUIZ_LIGHT_THRESHOLD  → Light quiz  (QUIZ_LIGHT_QUESTIONS questions)
# Chapters < QUIZ_STANDARD_THRESHOLD → Standard quiz  (QUIZ_STANDARD_QUESTIONS questions)
# Chapters ≥ QUIZ_STANDARD_THRESHOLD → Deep quiz  (QUIZ_DEEP_QUESTIONS questions)
#
QUIZ_LIGHT_THRESHOLD=3600       # 60 minutes
QUIZ_STANDARD_THRESHOLD=10800   # 3 hours
#
# Number of questions shown to the student per quiz attempt (by tier):
QUIZ_LIGHT_QUESTIONS=8
QUIZ_STANDARD_QUESTIONS=15
QUIZ_DEEP_QUESTIONS=25
#
# Minimum total playlist duration (seconds) for the Final Playlist Quiz to appear.
# Default: 900 (15 minutes)
QUIZ_FINAL_MIN_SECONDS=900

# ── CORS / Frontend URL ─────────────────────────────────────────
# URL of the frontend dev server. Must match exactly.
# Default Vite port is 5173. Only change if you've changed the port.
FRONTEND_URL=http://localhost:5173
